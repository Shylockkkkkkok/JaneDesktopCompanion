{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dear Jane",
  "version": "1.0.1",
  "identifier": "com.jane.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dear Jane",
        "width": 300,
        "height": 380,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": false
      },
      {
        "label": "bubble",
        "title": "Dear Jane",
        "width": 380,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "center": false
      },
      {
        "label": "settings",
        "title": "Dear Jane 设置",
        "width": 360,
        "height": 430,
        "resizable": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": true
      },
      {
        "label": "goals",
        "title": "今日目标",
        "width": 300,
        "height": 380,
        "resizable": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": true
      },
      {
        "label": "concert",
        "title": "下一次Jane面",
        "width": 320,
        "height": 360,
        "resizable": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": true
      },
      {
        "label": "timeline",
        "title": "我与Jane的约会记录",
        "width": 340,
        "height": 480,
        "resizable": false,
        "visible": false,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
